{
  "manifest_version": 3,
  "name": "LinkedIn Job Collector",
  "version": "1.0.0",
  "description": "Collects the first 100 jobs from LinkedIn search results and copies them directly to the clipboard as CSV.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
